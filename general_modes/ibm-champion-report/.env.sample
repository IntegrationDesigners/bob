# IBM Champion Activity Report - personal identity (SAMPLE)
#
# Copy this file to ".env" in the same folder and replace the placeholders with
# your real values. The real ".env" is gitignored and stays private; this sample
# is committed and must contain ONLY placeholder values.
#
# Champion Program ID: the numeric ID issued when you applied to the program.

CHAMPION_PROGRAM_ID=20240000
FIRST_NAME=Jane
LAST_NAME=Doe
PRIMARY_EMAIL=jane.doe@example.com
ALTERNATE_EMAIL=jane@example.org

# Activity log: absolute path of ONE local markdown file (forward slashes, no
# quotes). Every reported activity is appended there as "date - type", the link and
# the description, so you can see what has already been reported and the skill can
# match a new report against the links already in there. A note inside an
# Obsidian vault works; the file is created on first use. Leave empty and the
# skill asks for the path on the first run and writes it back here.
ACTIVITY_LOG=

# IBM Community identity - used when navigating to the user's profile or blog
# listing without needing to ask for the URL each session.
IBM_COMMUNITY_PROFILE_URL=https://community.ibm.com/community/user/people/your-username
ACE_COMMUNITY_BLOG_URL=

# Default fill workflow: "normal" (every check, end screenshot) or "lean" (one read at
# the end, no snapshot, no screenshot - fewer tokens). A request that says "lean: on"
# or "normal" overrides this for that run. Missing or empty means normal.
FILL_MODE=normal
