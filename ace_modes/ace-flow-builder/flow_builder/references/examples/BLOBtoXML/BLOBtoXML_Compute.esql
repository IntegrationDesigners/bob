--			DECLARE PosAddressEnd INT POSITION('<' IN InString REPEAT 10*(I-1)+8);			
--			DECLARE PosDateOfBirthBegin INT POSITION('>' IN InString REPEAT 10*(I-1)+9);
--			DECLARE PosDateOfBirthEnd INT POSITION('<' IN InString REPEAT 10*(I-1)+10);
--			SET OutputRoot.XMLNSC.Message.Item[I].LastName
--			  = SUBSTRING(InString FROM PosLastNameBegin+1 FOR (PosLastNameEnd-PosLastNameBegin-1));  
--			SET OutputRoot.XMLNSC.Message.Item[I].FirstName
--			  = SUBSTRING(InString FROM PosFirstNameBegin+1 FOR (PosFirstNameEnd-PosFirstNameBegin-1));
--			SET OutputRoot.XMLNSC.Message.Item[I].Address
--			  = SUBSTRING(InString FROM PosAddressBegin+1 FOR (PosAddressEnd-PosAddressBegin-1));
