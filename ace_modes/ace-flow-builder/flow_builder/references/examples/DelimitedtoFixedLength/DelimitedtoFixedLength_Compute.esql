

CREATE COMPUTE MODULE DelimitedtoFixedLength_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN

		SET OutputRoot.Properties = InputRoot.Properties;
		CREATE LASTCHILD OF OutputRoot DOMAIN('DFDL');
		SET OutputRoot.DFDL.MessageFixedLength = InputRoot.DFDL.MessageDelimited;

		RETURN TRUE;
	END;

END MODULE;
