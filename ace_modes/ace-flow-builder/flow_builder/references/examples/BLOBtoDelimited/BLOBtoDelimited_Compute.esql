

CREATE COMPUTE MODULE BLOBtoDelimited_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN

		-- ================================
		-- OPTION 1 Simple Example
		-- If the input data happens to be structured, even if it arrived in the BLOB domain,
		-- then the code required to reparse the input BLOB as output Delimited is very short and simple.
		-- ================================
--		DECLARE CodedCharSetId INT 1208;
--		SET OutputRoot.Properties = InputRoot.Properties;
--		CREATE LASTCHILD OF OutputRoot DOMAIN('DFDL')
--		  PARSE(InputRoot.BLOB.BLOB TYPE '{}:MessageDelimited' CCSID CodedCharSetId);

		-- ================================			
		-- Option 2 More Complex Example
		-- The more detailed code below provides a deeper example
		-- String manipulation functions in ESQL are used to locate specific sections of the input BLOB 
		-- ================================		
		
		SET OutputRoot.Properties = InputRoot.Properties;		
		CREATE LASTCHILD OF OutputRoot DOMAIN('DFDL');
		DECLARE CodedCharSetId INT 1208;
		DECLARE InString CHAR CAST(InputRoot.BLOB.BLOB AS CHAR CCSID CodedCharSetId);
		DECLARE I INTEGER;
		SET I = 1;
		WHILE I < 5 DO			
			DECLARE PosLastNameEnd INT POSITION(',' IN InString REPEAT 3*(I-1)+1);
			DECLARE PosFirstNameBegin INT POSITION(',' IN InString REPEAT 3*(I-1)+1);
			DECLARE PosFirstNameEnd INT POSITION(',' IN InString REPEAT 3*(I-1)+2);			
			DECLARE PosAddressBegin INT POSITION(',' IN InString REPEAT 3*(I-1)+2);
			DECLARE PosAddressEnd INT POSITION(',' IN InString REPEAT 3*(I-1)+3);			
			DECLARE PosDateOfBirthBegin INT POSITION(',' IN InString REPEAT 3*(I-1)+3);
			IF I = 1 THEN 
				SET OutputRoot.DFDL.MessageDelimited.Item[I].LastName
			  		= SUBSTRING(InString FROM 0 FOR (PosLastNameEnd));
			ELSE
				DECLARE PosLastNameBegin INT POSITION('-' IN InString REPEAT 2*(I-1))+3;
				SET OutputRoot.DFDL.MessageDelimited.Item[I].LastName
			  		= SUBSTRING(InString FROM PosLastNameBegin FOR (PosLastNameEnd-PosLastNameBegin));
			END IF;
			SET OutputRoot.DFDL.MessageDelimited.Item[I].FirstName
			  = SUBSTRING(InString FROM PosFirstNameBegin+1 FOR (PosFirstNameEnd-PosFirstNameBegin-1));
			SET OutputRoot.DFDL.MessageDelimited.Item[I].Address
			  = SUBSTRING(InString FROM PosAddressBegin+1 FOR (PosAddressEnd-PosAddressBegin-1));
			SET OutputRoot.DFDL.MessageDelimited.Item[I].DateOfBirth
			  = SUBSTRING(InString FROM PosDateOfBirthBegin+1 FOR 10);
			SET I = I + 1;
		END WHILE;

		RETURN TRUE;
	END;
END MODULE;
