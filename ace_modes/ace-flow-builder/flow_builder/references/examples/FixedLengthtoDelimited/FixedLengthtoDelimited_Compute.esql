

CREATE COMPUTE MODULE FixedLengthtoDelimited_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN

		SET OutputRoot.Properties = InputRoot.Properties;
		CREATE LASTCHILD OF OutputRoot DOMAIN('DFDL');
		SET OutputRoot.DFDL.MessageDelimited = InputRoot.DFDL.MessageFixedLength;

		RETURN TRUE;
	END;
END MODULE;
