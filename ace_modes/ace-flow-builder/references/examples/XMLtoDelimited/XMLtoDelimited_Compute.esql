

CREATE COMPUTE MODULE XMLtoDelimited_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN

		SET OutputRoot.Properties = InputRoot.Properties;
		CREATE LASTCHILD OF OutputRoot DOMAIN('DFDL');
		SET OutputRoot.DFDL.MessageDelimited = InputRoot.XMLNSC.Message;		
		
		RETURN TRUE;
	END;
END MODULE;
