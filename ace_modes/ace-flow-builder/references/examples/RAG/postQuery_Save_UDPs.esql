
DECLARE IndexName EXTERNAL CHARACTER;
DECLARE ProjectID EXTERNAL CHARACTER;

CREATE COMPUTE MODULE postQuery_Save_UDPs
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		SET Environment.Variable.query = InputRoot.JSON.Data.query;
		SET Environment.Variable.IndexName = IndexName;
		SET Environment.Variable.ProjectID = ProjectID;
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
