

CREATE COMPUTE MODULE BLOBtoJSON_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- ================================
		-- OPTION 1 Simple Example
		-- If the input data happens to be structured, even if it arrived in the BLOB domain,
		-- then the code required to reparse the input BLOB as output JSON is very short and simple.
		-- ================================
		DECLARE CodedCharSetId INT 1208;
		SET OutputRoot.Properties = InputRoot.Properties;
		CREATE LASTCHILD OF OutputRoot DOMAIN('JSON')
		  PARSE(InputRoot.BLOB.BLOB CCSID CodedCharSetId);

		-- ================================			
		-- Option 2 More Complex Example
