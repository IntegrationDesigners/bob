

CREATE COMPUTE MODULE EmailtoDatabase_Database
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		DECLARE MyRef REFERENCE TO InputRoot.BLOB.BLOB;
		DECLARE DBSchema CHARACTER 'MYSCHEMA';				
		DECLARE DBTable  CHARACTER 'MYTABLE';
		INSERT INTO Database.{DBSchema}.{DBTable} (BLOBMESSAGE)
					VALUES( MyRef );		
		CALL CopyMessageHeaders();
		SET OutputRoot.JSON.Database.SQLCODE = SQLCODE;
		SET OutputRoot.JSON.Exception.SQLSTATE = SQLSTATE;	
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
