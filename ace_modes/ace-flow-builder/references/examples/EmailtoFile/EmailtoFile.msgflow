      </nodes>
      <nodes xmi:type="ComIbmEmailInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_6" location="99,67" emailServer="imaps://imap.gmail.com:993" waitInterval="3" securityIdentity="acegmailinput">
