    <translation xmi:type="utility:TranslatableString" key="EmailtoFile" bundleName="EmailtoFile" pluginId="EmailtoFile"/>
    <colorGraphic16 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/EmailtoFile/icons/full/obj16/EmailtoFile.gif"/>
    <colorGraphic32 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/EmailtoFile/icons/full/obj30/EmailtoFile.gif"/>
    <composition>
      <nodes xmi:type="ComIbmMSLMapping.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_1" location="512,16" mappingExpression="msl://{default}#EmailtoFile_Mapping">
        <translation xmi:type="utility:ConstantString" string="Mapping"/>
      </nodes>
      <nodes xmi:type="ComIbmFileOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_2" location="313,16" outputDirectory="C:\FileOutput\EmailtoFile" outputFilename="OutputFile.txt">
